{
  "name": "memokeep-community",
  "version": "1.0.1",
  "private": true,
  "author": "MemoKeep",
  "description": "Local-first personal knowledge base and long-term memory companion.",
  "scripts": {
    "start": "npm --prefix apps/desktop start",
    "web": "node scripts/serve.cjs",
    "check": "node scripts/check.cjs",
    "test": "node scripts/test.cjs",
    "test:js": "node --test scripts/*.test.cjs",
    "verify:source": "node scripts/verify-source.cjs",
    "test:desktop": "npm --prefix apps/desktop run test:desktop",
    "stage:community": "npm --prefix apps/desktop run build",
    "pack:mac": "npm --prefix apps/desktop run pack:mac",
    "dist:mac": "npm --prefix apps/desktop run dist:mac"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "@mixmark-io/domino": "^2.2.0",
    "choices.js": "^11.2.3",
    "quill": "^2.0.3",
    "ts-fsrs": "5.4.2"
  },
  "productName": "MemoKeep Community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/coderbruis/memokeep.git"
  }
}
